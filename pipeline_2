pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/RAHAMSHAIK007/jenkins-java-project-1.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('SonarQube') {
            steps {
                sh 'mvn sonar:sonar'
            }
        }

        stage('OWASP') {
            steps {
                sh 'mvn dependency-check:check'
            }
        }

        stage('Trivy') {
            steps {
                sh 'trivy fs --severity HIGH,CRITICAL .'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t myapp:latest .'
            }
        }
    }
}
