pipeline {
    agent any

    tools {
        maven 'maven'
    }

    stages {
        stage('Code') {
            steps {
                git 'https://github.com/RAHAMSHAIK007/jenkins-java-project-1.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Artifact') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deploy') {
            steps {
                echo 'My code is deployed'
            }
        }
    }
}
